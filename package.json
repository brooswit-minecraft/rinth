{
  "name": "@brooswit/rinth",
  "version": "0.7.0",
  "private": false,
  "type": "module",
  "description": "A Modrinth CLI (servers management + publish) wrapping @modrinth/api-client.",
  "bin": {
    "rinth": "./src/cli.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "test": "bun test test/unit",
    "test:integration": "bun test test/integration",
    "test:coverage": "bun test --coverage test/unit",
    "changelog:check": "bun run scripts/check-changelog.ts"
  },
  "dependencies": {
    "@modrinth/api-client": "0.60.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "oxlint": "^1.80.0",
    "typescript": "^7.0.2"
  }
}
